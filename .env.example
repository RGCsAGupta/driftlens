# Public desired-state source. Private repositories are not supported.
DRIFTLENS_GITHUB_REPOSITORY=your-org/your-public-repository
DRIFTLENS_MANIFEST_PATH=path/to/deployment.yaml

# Absolute path to a dedicated read-only kubeconfig on the local machine.
DRIFTLENS_KUBECONFIG_PATH=/absolute/path/to/read-only.kubeconfig

# Optional when the kubeconfig current context is already the intended target.
# DRIFTLENS_KUBECONTEXT=your-read-only-context

# Optional local SQLite directory. Defaults to .driftlens.
# DRIFTLENS_DATA_DIR=/absolute/path/to/driftlens-data

# Optional manual AI analysis. Both values are required together.
# Keep the key server-side, replace it only in ignored local/runtime config,
# and never commit or print the real value.
# OPENAI_API_KEY=replace-locally
# OPENAI_MODEL=gpt-5.6
